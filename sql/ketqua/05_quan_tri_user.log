SQL> -- ---------------------------------------------------------------------
SQL> -- 1. PROFILE: gói giới hạn về mật khẩu và tài nguyên gán cho user.
SQL> --    Giới hạn phiên (SESSIONS_PER_USER, IDLE_TIME, CONNECT_TIME) chỉ có hiệu lực khi
SQL> --    tham số RESOURCE_LIMIT = TRUE (mặc định TRUE từ 12c).
SQL> -- ---------------------------------------------------------------------
SQL> SHOW PARAMETER resource_limit

NAME                                 TYPE        VALUE                                                                                                                                                                      
------------------------------------ ----------- ------------------------------                                                                                                                                             
resource_limit                       boolean     TRUE                                                                                                                                                                       
SQL> 
SQL> -- Profile cho người dùng thường: chặt hơn
SQL> CREATE PROFILE PROFILE_NHANVIEN LIMIT
  2    FAILED_LOGIN_ATTEMPTS 3	      -- nhập sai 3 lần thì khóa tài khoản
  3    PASSWORD_LOCK_TIME    1/24     -- tự mở khóa sau 1 giờ (đơn vị: ngày)
  4    PASSWORD_LIFE_TIME    90       -- mật khẩu hết hạn sau 90 ngày
  5    PASSWORD_GRACE_TIME   7	      -- được 7 ngày cảnh báo trước khi hết hạn hẳn
  6    PASSWORD_REUSE_MAX    5	      -- không dùng lại 5 mật khẩu gần nhất
  7    SESSIONS_PER_USER     2	      -- tối đa 2 phiên đồng thời
  8    IDLE_TIME	     30       -- ngắt phiên không hoạt động sau 30 phút (CONNECT_TIME: tối đa 480 phút/phiên)
  9    CONNECT_TIME	     480;

Profile created.

SQL> 
SQL> -- Profile cho quản trị: nới hơn
SQL> CREATE PROFILE PROFILE_QUANTRI LIMIT
  2    FAILED_LOGIN_ATTEMPTS 5
  3    PASSWORD_LOCK_TIME    1/24
  4    PASSWORD_LIFE_TIME    60       -- quản trị phải đổi mật khẩu thường xuyên hơn
  5    SESSIONS_PER_USER     5
  6    IDLE_TIME	     60;

Profile created.

SQL> 
