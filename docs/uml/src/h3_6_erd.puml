@startuml h3_6_erd
!include _style.iuml
!pragma layout smetana
hide circle
skinparam linetype ortho

entity NGUOI_DUNG {
  * MA_ND : NUMBER <<PK>>
  --
  * HO_TEN : VARCHAR2
  * EMAIL : VARCHAR2 <<UK>>
  * MAT_KHAU : VARCHAR2
  DON_VI : VARCHAR2
  * VAI_TRO : USER | ADMIN
  SDT : VARCHAR2
  * TRANG_THAI : HOAT_DONG | KHONG_HOAT_DONG
  NGAY_TAO : DATE
  MA_NGUOI_TAO : NUMBER <<FK>>
  NGAY_XOA : DATE
  MA_NGUOI_XOA : NUMBER <<FK>>
}
entity PHONG {
  * MA_PHONG : NUMBER <<PK>>
  --
  * TEN_PHONG : VARCHAR2
  * TOA_NHA : VARCHAR2
  TANG : NUMBER
  * LOAI_PHONG : VARCHAR2
}
entity THIET_BI {
  * MA_TB : NUMBER <<PK>>
  --
  * TEN_TB : VARCHAR2
  * LOAI_TB : VARCHAR2
  * MA_PHONG : NUMBER <<FK>>
  * TINH_TRANG : HOAT_DONG | HONG | DANG_SUA
  NHA_CUNG_CAP : VARCHAR2
  NGAY_LAP_DAT : DATE
  HDSD : VARCHAR2
}
entity DANH_MUC_SU_CO {
  * MA_DM : NUMBER <<PK>>
  --
  * TEN_DM : VARCHAR2 <<UK>>
  MO_TA : VARCHAR2
}
entity BAI_KINH_NGHIEM {
  * MA_BAI : NUMBER <<PK>>
  --
  * TIEU_DE : VARCHAR2
  * MA_DM : NUMBER <<FK>>
  TRIEU_CHUNG : VARCHAR2
  NGUYEN_NHAN : VARCHAR2
  * GIAI_PHAP : VARCHAR2
  * MA_NGUOI_VIET : NUMBER <<FK>>
  NGAY_TAO : DATE
}
entity SU_CO {
  * MA_SC : NUMBER <<PK>>
  --
  * TIEU_DE : VARCHAR2
  MO_TA : VARCHAR2
  * MA_NGUOI_BAO : NUMBER <<FK>>
  MA_ADMIN_XU_LY : NUMBER <<FK>>
  MA_TB : NUMBER <<FK>>
  * MA_DM : NUMBER <<FK>>
  * MUC_UU_TIEN : THAP | TRUNG_BINH | CAO
  * TRANG_THAI : MOI | DANG_XU_LY | HOAN_THANH
  NGUYEN_NHAN : VARCHAR2
  CACH_KHAC_PHUC : VARCHAR2
  MA_BAI_KN : NUMBER <<FK>>
  ANH_DINH_KEM : VARCHAR2
  NGAY_TAO : DATE
  NGAY_HOAN_THANH : DATE
}
entity LICH_SU_XU_LY {
  * MA_LS : NUMBER <<PK>>
  --
  * MA_SC : NUMBER <<FK>>
  MA_NGUOI_CAP_NHAT : NUMBER <<FK>>
  TRANG_THAI_CU : VARCHAR2
  * TRANG_THAI_MOI : VARCHAR2
  GHI_CHU : VARCHAR2
  THOI_GIAN : TIMESTAMP
}
entity PHAN_HOI {
  * MA_PH : NUMBER <<PK>>
  --
  * MA_SC : NUMBER <<FK, UK>>
  * MA_NGUOI_PHAN_HOI : NUMBER <<FK>>
  * MUC_HAI_LONG : 1..5
  NOI_DUNG : VARCHAR2
  NGAY_PHAN_HOI : DATE
}
entity BINH_LUAN_SU_CO {
  * MA_BL : NUMBER <<PK>>
  --
  * MA_SC : NUMBER <<FK>>
  * MA_NGUOI_GUI : NUMBER <<FK>>
  NOI_DUNG : VARCHAR2
  TEP_DINH_KEM : VARCHAR2
  THOI_GIAN : TIMESTAMP
}

PHONG ||--o{ THIET_BI
THIET_BI |o--o{ SU_CO
DANH_MUC_SU_CO ||--o{ SU_CO
DANH_MUC_SU_CO ||--o{ BAI_KINH_NGHIEM
BAI_KINH_NGHIEM |o--o{ SU_CO
NGUOI_DUNG ||--o{ SU_CO : báo
NGUOI_DUNG |o--o{ SU_CO : xử lý
NGUOI_DUNG ||--o{ BAI_KINH_NGHIEM : viết
SU_CO ||--o{ LICH_SU_XU_LY
SU_CO ||--o| PHAN_HOI
SU_CO ||--o{ BINH_LUAN_SU_CO
NGUOI_DUNG |o--o{ LICH_SU_XU_LY
NGUOI_DUNG ||--o{ PHAN_HOI
NGUOI_DUNG ||--o{ BINH_LUAN_SU_CO
NGUOI_DUNG |o--o{ NGUOI_DUNG : tạo / vô hiệu hóa
@enduml
